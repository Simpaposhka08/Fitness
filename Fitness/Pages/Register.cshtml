@page
@model RegisterModel
@{
    ViewData["Title"] = "Регистрация";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card">
                <div class="card-header text-center">
                    <h2 class="mb-0">✨ Регистрация</h2>
                    <p class="mb-0 mt-2" style="color: var(--text-light); font-size: 0.9rem;">
                        Создайте аккаунт и начните тренироваться!
                    </p>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

                        <div class="form-group mb-3">
                            <label asp-for="Name" class="form-label">
                                👤 Имя
                            </label>
                            <span asp-validation-for="Name" class="text-danger d-block"></span>
                            <input type="text" 
                                   class="form-control" 
                                   id="first_name" 
                                   asp-for="Name" 
                                   placeholder="Введите ваше имя"
                                   required>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="PhoneNumber" class="form-label">
                                📱 Номер телефона
                            </label>
                            <span asp-validation-for="PhoneNumber" class="text-danger d-block"></span>
                            <input type="text" 
                                   class="form-control" 
                                   id="phone_number" 
                                   asp-for="PhoneNumber" 
                                   placeholder="+7 (999) 123-45-67"
                                   required>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Password" class="form-label">
                                🔒 Пароль
                            </label>
                            <span asp-validation-for="Password" class="text-danger d-block"></span>
                            <input type="password" 
                                   class="form-control" 
                                   id="password" 
                                   asp-for="Password" 
                                   placeholder="Минимум 6 символов"
                                   required>
                            <small class="form-text" style="color: var(--text-light);">
                                Пароль должен содержать от 6 до 100 символов
                            </small>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="ConfirmPassword" class="form-label">
                                🔒 Подтвердите пароль
                            </label>
                            <span asp-validation-for="ConfirmPassword" class="text-danger d-block"></span>
                            <input type="password" 
                                   class="form-control" 
                                   id="confirm_password" 
                                   asp-for="ConfirmPassword" 
                                   placeholder="Повторите пароль"
                                   required>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                🎉 Зарегистрироваться
                            </button>
                        </div>
                    </form>

                    <div class="text-center mt-4">
                        <p style="color: var(--text-light);">
                            Уже есть аккаунт? 
                            <a asp-page="/Login" style="color: var(--accent-coral); text-decoration: none; font-weight: 600;">
                                Войдите
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
