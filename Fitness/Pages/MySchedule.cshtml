@page
@model MyScheduleModel
@{
    ViewData["Title"] = "Мое расписание";
}

<div class="container mt-4">
    <h1 class="text-center mb-4">📅 Мое расписание</h1>

    @if (Model.PurchasedWorkouts != null && Model.PurchasedWorkouts.Any())
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="mb-0">🎯 Ваши записанные тренировки</h4>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>📅 Дата</th>
                                        <th>⏰ Время</th>
                                        <th>💪 Тренировка</th>
                                        <th>👨‍🏫 Тренер</th>
                                        <th>💰 Цена</th>
                                        <th class="text-center">⚙️ Действия</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var purchasedWorkout in Model.PurchasedWorkouts)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@purchasedWorkout.Workout.StartTime.ToString("dd MMM yyyy")</strong>
                                            </td>
                                            <td>
                                                @purchasedWorkout.Workout.StartTime.ToString("HH:mm") - @purchasedWorkout.Workout.EndTime.ToString("HH:mm")
                                            </td>
                                            <td>
                                                <strong>@purchasedWorkout.Workout.Title</strong>
                                            </td>
                                            <td>@purchasedWorkout.Workout.Trainer</td>
                                            <td>
                                                <span style="color: var(--accent-coral); font-weight: 600;">
                                                    @purchasedWorkout.Workout.Price.ToString("C")
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <form method="post" asp-page-handler="Cancel" asp-route-id="@purchasedWorkout.Id" class="d-inline">
                                                    <button type="submit" 
                                                            class="btn btn-danger btn-sm" 
                                                            onclick="return confirm('Вы уверены, что хотите отменить запись на эту тренировку?');">
                                                        ❌ Отменить
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer text-end">
                        <strong>
                            Всего тренировок: <span style="color: var(--accent-teal);">@Model.PurchasedWorkouts.Count</span>
                        </strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Карточки для мобильных устройств -->
        <div class="row d-md-none">
            @foreach (var purchasedWorkout in Model.PurchasedWorkouts)
            {
                <div class="col-12 mb-3">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">💪 @purchasedWorkout.Workout.Title</h5>
                        </div>
                        <div class="card-body">
                            <p class="mb-2">
                                <strong>📅 Дата:</strong> @purchasedWorkout.Workout.StartTime.ToString("dd MMMM yyyy")
                            </p>
                            <p class="mb-2">
                                <strong>⏰ Время:</strong> @purchasedWorkout.Workout.StartTime.ToString("HH:mm") - @purchasedWorkout.Workout.EndTime.ToString("HH:mm")
                            </p>
                            <p class="mb-2">
                                <strong>👨‍🏫 Тренер:</strong> @purchasedWorkout.Workout.Trainer
                            </p>
                            <p class="mb-3">
                                <strong>💰 Цена:</strong> 
                                <span style="color: var(--accent-coral); font-weight: 600; font-size: 1.1rem;">
                                    @purchasedWorkout.Workout.Price.ToString("C")
                                </span>
                            </p>
                            <form method="post" asp-page-handler="Cancel" asp-route-id="@purchasedWorkout.Id">
                                <button type="submit" 
                                        class="btn btn-danger w-100" 
                                        onclick="return confirm('Вы уверены, что хотите отменить запись на эту тренировку?');">
                                    ❌ Отменить запись
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="card" style="max-width: 500px; margin: 0 auto;">
                <div class="card-body">
                    <h3 style="font-size: 4rem; margin-bottom: 1rem;">📭</h3>
                    <h4>У вас нет записанных тренировок</h4>
                    <p class="text-muted mb-4">
                        Запишитесь на тренировку, чтобы она появилась здесь!
                    </p>
                    <a asp-page="/Index" class="btn btn-primary btn-lg">
                        💪 Посмотреть расписание
                    </a>
                </div>
            </div>
        </div>
    }
</div>

